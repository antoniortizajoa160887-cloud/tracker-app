<?xml version="1.0" encoding="utf-8"?>
<!--
  A map-pin mark: fits the logistics/routes half of the app, in the same
  emerald-to-cyan brand colors as the login screen's accent button, with a
  dark cutout center matching the app's dark background rather than a
  generic placeholder shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- pin body: circular head (center 54,44 r18) + triangular point to (54,86) -->
    <path
        android:fillColor="#10b981"
        android:pathData="M36,44 A18,18 0 1,0 72,44 A18,18 0 1,0 36,44 Z
                           M39,54 L69,54 L54,86 Z" />
    <!-- cyan ring accent -->
    <path
        android:fillColor="#06b6d4"
        android:pathData="M44.5,44 A9.5,9.5 0 1,0 63.5,44 A9.5,9.5 0 1,0 44.5,44 Z" />
    <!-- dark cutout to read as a hollow pin -->
    <path
        android:fillColor="#08101A"
        android:pathData="M47,44 A7,7 0 1,0 61,44 A7,7 0 1,0 47,44 Z" />
</vector>
